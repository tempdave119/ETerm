{
  "name": "eterm",
  "version": "0.6.0",
  "private": true,
  "description": "macOS 优先的 SSH / SFTP 工作台",
  "author": "Kevin",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "icon": "electron scripts/make-icon.mjs",
    "icon:tray": "electron scripts/make-tray-icon.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "ssh-smoke": "node scripts/ssh-smoke.mjs",
    "swap-smoke": "ETERM_SWAP_ONLY=1 node scripts/ssh-smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --mac dmg",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "build": {
    "appId": "com.eterm.app",
    "productName": "ETerm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "examples/components",
        "to": "components"
      }
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@serialport/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns"
    },
    "dmg": {
      "title": "ETerm ${version}",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "node-pty": "^1.1.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
